{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "personal-strategy.schema.json",
  "title": "Personal stock strategy",
  "type": "object",
  "required": ["id", "name", "version", "grade_thresholds", "filters"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "name": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "grade_thresholds": {
      "type": "object",
      "required": ["S", "A", "B"],
      "properties": {
        "S": {"type": "integer"},
        "A": {"type": "integer"},
        "B": {"type": "integer"}
      },
      "additionalProperties": false
    },
    "preferred_sectors": {"type": "array", "items": {"type": "string"}},
    "avoided_sectors": {"type": "array", "items": {"type": "string"}},
    "rotation_bonus": {"type": "integer"},
    "filters": {
      "type": "object",
      "required": ["exclude_prefixes", "exclude_st", "max_positions", "capital_cny"],
      "properties": {
        "exclude_prefixes": {"type": "array", "items": {"type": "string"}},
        "exclude_st": {"type": "boolean"},
        "max_positions": {"type": "integer", "minimum": 1},
        "capital_cny": {"type": "number", "exclusiveMinimum": 0}
      }
    }
  }
}

